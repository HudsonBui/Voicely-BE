# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here-please-change-this-in-production
JWT_REFRESH_SECRET_KEY=your-super-secret-refresh-key-here-please-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/voicely_db

# Optional: Override default token expiration times
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_MINUTES=10080