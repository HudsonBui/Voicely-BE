# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here-please-change-this-in-production
JWT_REFRESH_SECRET_KEY=your-super-secret-refresh-key-here-please-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/voicely_db

# Optional: Override default token expiration times
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Google Cloud Speech-to-Text Configuration
# Path to service account key file (required for transcription)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Google Cloud Storage Configuration (for large audio files > 1MB or > 60s)
# Create a bucket in Google Cloud Storage and set its name here
# This enables transcription of large audio files that exceed direct API limits
GCS_BUCKET_NAME=your-gcs-bucket-name

# Alternative: Set GOOGLE_CLOUD_PROJECT if using other authentication methods
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Audio Processing Configuration (optional)
MAX_AUDIO_FILE_SIZE=52428800  # 50MB in bytes
SUPPORTED_AUDIO_FORMATS=wav,mp3,m4a,aac,flac,ogg